# -----------------------------------------------------------------------
# Copy this file to .env and fill in the values.
# NEVER commit your actual .env file to version control.
# -----------------------------------------------------------------------

# Generate a strong key: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string

# Set to False in production
DEBUG=False

# Comma-separated list of domains your backend is served from
ALLOWED_HOSTS=localhost,127.0.0.1

# Leave empty to use local SQLite (development only).
# For Postgres (e.g. Neon), use:
# DATABASE_URL=postgres://user:password@ep-xxxx.neon.tech/zoodb?sslmode=require
DATABASE_URL=

# Comma-separated list of your deployed frontend URL(s)
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Set to True when serving behind HTTPS in production (e.g. Render, Railway)
SECURE_SSL_REDIRECT=False

# HSTS max-age in seconds (0 = disabled). Set to 31536000 (1 year) in production.
SECURE_HSTS_SECONDS=0
